# Core Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Lagos

# Database
DATABASE_URL=postgresql://nicesa:change-me@127.0.0.1:5432/nicesa
DB_CONN_MAX_AGE=60

# Separate SPA frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# Refresh-token cookie. Use SameSite=None and Secure=True only when the SPA is
# hosted on a different site (different registrable domain) from the API.
REFRESH_COOKIE_NAME=nicesa_refresh
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth/

# JWT and auth security
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_THROTTLE_RATE=10/minute
REGISTRATION_THROTTLE_RATE=5/hour
RESEND_VERIFICATION_THROTTLE_RATE=5/hour
PASSWORD_RESET_THROTTLE_RATE=5/hour
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60

# Email links
DEFAULT_FROM_EMAIL=NICESA <no-reply@example.com>
FRONTEND_VERIFY_URL=http://localhost:3000/verify-email
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# SMTP is used when DJANGO_ENV is not development.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Reverse proxy. Set this to the number of trusted proxies in front of Django.
TRUSTED_PROXY_COUNT=1
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
